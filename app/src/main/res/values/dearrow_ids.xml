<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tags used by DeArrowBinder to detect a recycled row. Declared as ids so that the
         tag keys are guaranteed unique and cannot collide with another feature's setTag(). -->
    <item name="dearrow_video_id" type="id" />
    <item name="dearrow_disposable" type="id" />
    <item name="dearrow_frame_disposable" type="id" />
    <item name="dearrow_thumbnail_disposable" type="id" />
    <!-- True while a row is deliberately holding the placeholder instead of the uploader's
         thumbnail, so whichever DeArrow source finishes last knows it still owes the row an
         image if it has nothing of its own. -->
    <item name="dearrow_original_pending" type="id" />
</resources>
