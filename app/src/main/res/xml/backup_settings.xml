<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:key="general_preferences"
                  android:title="@string/settings_category_backup_title">
    <Preference
            android:key="@string/import_data"
            android:summary="@string/import_data_summary"
            android:title="@string/import_data_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="@string/export_data"
            android:summary="@string/export_data_summary"
            android:title="@string/export_data_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <PreferenceCategory
            android:layout="@layout/settings_category_header_layout"
            android:title="@string/tab_subscriptions"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false">

        <Preference
                android:key="@string/import_subscriptions_key"
                android:summary="@string/import_subscriptions_summary"
                android:title="@string/import_subscriptions_title"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/import_youtube_subscriptions_key"
                android:summary="@string/import_youtube_subscriptions_summary"
                android:title="@string/import_youtube_subscriptions_title"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/import_soundcloud_subscriptions_key"
                android:summary="@string/import_soundcloud_subscriptions_summary"
                android:title="@string/import_soundcloud_subscriptions_title"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/export_subscriptions_key"
                android:summary="@string/export_subscriptions_summary"
                android:title="@string/export_subscriptions_title"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="@string/clear_subscriptions_key"
                android:summary="@string/clear_subscriptions_summary"
                android:title="@string/clear_subscriptions_title"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
