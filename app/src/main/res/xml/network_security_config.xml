<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 lacks ISRG Root X1 (added in 7.1.1), which *.githubusercontent.com chains to. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
