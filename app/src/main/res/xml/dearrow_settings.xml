<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/dearrow">

    <Preference
        app:iconSpaceReserved="false"
        android:key="@string/dearrow_home_page_key"
        android:summary="@string/dearrow_home_page_summary"
        android:title="@string/dearrow_home_page_title"/>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/settings">

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:defaultValue="false"
            android:key="@string/dearrow_enable_key"
            android:summary="@string/dearrow_enable_summary"
            android:title="@string/dearrow_enable_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_replace_titles_key"
            android:summary="@string/dearrow_replace_titles_summary"
            android:title="@string/dearrow_replace_titles_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_replace_thumbnails_key"
            android:summary="@string/dearrow_replace_thumbnails_summary"
            android:title="@string/dearrow_replace_thumbnails_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_random_frame_key"
            android:summary="@string/dearrow_random_frame_summary"
            android:title="@string/dearrow_random_frame_title"/>

        <!-- Live is its own switch, and OFF by default, because it is the one path whose cost
             is not comparable to the others. A normal video's frame is one small image fetch
             from the thumbnail host; a broadcast has no stored frame at all, so the only way
             to get one is to resolve the stream and briefly open it. That is a player request
             plus a media decode for every live row scrolled past, and it should be something
             the user opts into knowingly rather than something that rides along with the
             general thumbnail setting. Depends on the frame fallback, not just on DeArrow:
             it is a narrower case of the same behaviour. -->
        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_random_frame_key"
            android:defaultValue="false"
            android:key="@string/dearrow_live_frame_key"
            android:summary="@string/dearrow_live_frame_summary"
            android:title="@string/dearrow_live_frame_title"/>

        <SwitchPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="true"
            android:key="@string/dearrow_auto_format_key"
            android:summary="@string/dearrow_auto_format_summary"
            android:title="@string/dearrow_auto_format_title"/>

        <Preference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:key="@string/dearrow_clear_cache_key"
            android:summary="@string/dearrow_clear_cache_summary"
            android:title="@string/dearrow_clear_cache_title"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="@string/dearrow_advanced_category">

        <EditTextPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="https://sponsor.ajay.app"
            android:key="@string/dearrow_api_url_key"
            android:summary="@string/dearrow_api_url_summary"
            android:title="@string/dearrow_api_url_title"/>

        <EditTextPreference
            app:iconSpaceReserved="false"
            android:dependency="@string/dearrow_enable_key"
            android:defaultValue="https://dearrow-thumb.ajay.app/api/v1/getThumbnail"
            android:key="@string/dearrow_thumbnail_api_url_key"
            android:summary="@string/dearrow_thumbnail_api_url_summary"
            android:title="@string/dearrow_thumbnail_api_url_title"/>

    </PreferenceCategory>

</PreferenceScreen>
